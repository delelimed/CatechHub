<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths per CatechHub

    L1 / Fase 4-11: path MINIMALI. In passato il FileProvider esponeva le
    directory interne dell'app (files-path/cache-path/external-files-path con
    path="."), rendendo ogni file di CatechHub (incl. allegati cifrati nel
    secure_vault e dati Hive) condivisibile con altre app tramite content URI.

    FileProvider è usato SOLO per l'installazione dell'APK di aggiornamento
    (MainActivity.installApk → getUriForFile). L'APK viene salvato in una
    sottodirectory dedicata `apk_updates/` della directory esterna dell'app
    (path_provider getExternalStorageDirectory) e qui esposta SOLO quella.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Unica directory esposta: la sottocartella APK di aggiornamento.
         `external-files-path` = getExternalFilesDir() (= getExternalStorageDirectory). -->
    <external-files-path name="apk_updates" path="apk_updates/" />
</paths>